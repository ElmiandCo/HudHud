# HudHud social OAuth — server-only variables
# Never expose these with NEXT_PUBLIC_ prefixes.

HUDHUD_PUBLIC_URL=https://YOUR-HUDHUD-DOMAIN
HUDHUD_OAUTH_STATE_SECRET=GENERATE_A_LONG_RANDOM_SECRET
HUDHUD_OAUTH_ENCRYPTION_KEY=BASE64_32_BYTE_KEY

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok OAuth scopes. Start with profile access; add video.publish/video.upload only after those scopes are approved for your TikTok app.
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
